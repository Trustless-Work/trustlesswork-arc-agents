# Copy to .env.local and fill in. Never commit .env.local.

# Model: the agents call Claude through Anthropic's API.
ANTHROPIC_API_KEY=

# Trustless Work API for Arc, ending with the network (/testnet). The key can be inline or in a file (TW_API_KEY_FILE wins).
TW_API_URL=https://arc-api-demo-production.up.railway.app/testnet
TW_API_KEY=
TW_API_KEY_FILE=

# Circle developer-controlled wallets (console.circle.com, a testnet API key).
# Run `npm run circle:entity-secret` once to create and register the entity secret.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Optional: the wallet set new agent wallets go into. Created on first use when empty.
CIRCLE_WALLET_SET_ID=

# Optional
ARC_RPC_URL=https://rpc.testnet.arc.io
# Where the agent registry and decision log are kept (JSON files).
AGENTS_DATA_DIR=.data
# Required in production to create agents (Authorization: Bearer <token>). Open in local dev when empty.
AGENT_FACTORY_TOKEN=
